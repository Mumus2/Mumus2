# Twitch — crie um app em https://dev.twitch.tv/console/apps (tipo "Confidential")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube — Google Cloud Console > APIs & Services > Credentials
# Crie um "OAuth client ID" do tipo "Desktop app" e ative a "YouTube Data API v3"
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Senha do painel web (usuario: admin). Deixe vazio para painel sem senha (só use em localhost!)
DASHBOARD_PASSWORD=
